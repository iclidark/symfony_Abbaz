{% extends 'base.html.twig' %}

{% block title %}Apply - Step {{ step }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Application: Step {{ step }} of {{ total_steps }}</h1>
                    </div>
                    <div class="card-body">
                        {% if total_steps > 1 %}
                            <div class="progress mb-4" style="height: 20px;">
                                <div class="progress-bar" role="progressbar" style="width: {{ (step / total_steps) * 100 }}%;" aria-valuenow="{{ step }}" aria-valuemin="1" aria-valuemax="{{ total_steps }}">
                                    Step {{ step }} / {{ total_steps }}
                                </div>
                            </div>
                        {% endif %}

                        {{ form_start(form) }}
                        {{ form_widget(form) }}

                        <div class="d-flex justify-content-between mt-4">
                            {% if step > 1 %}
                                <a href="{{ path('app_apply_step', {'step': step - 1}) }}" class="btn btn-secondary">Previous</a>
                            {% else %}
                                <span></span> {# Empty span to keep the 'Next' button to the right #}
                            {% endif %}

                            <button type="submit" class="btn btn-primary">Next</button>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
