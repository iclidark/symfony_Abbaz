{% extends 'base.html.twig' %}

{% block title %}Task List{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fa-solid fa-tasks me-2"></i>Task List</h1>
        <a href="{{ path('task_new') }}" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>New Task</a>
    </div>

    {% for flash_message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ flash_message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row">
        {% for task in tasks|reverse %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a href="{{ path('task_show', {'id': task.id}) }}" class="text-decoration-none">{{ task.title }}</a>
                        </h5>
                        <p class="card-subtitle mb-2 text-muted">
                            By {{ task.author ? task.author.firstname ~ ' ' ~ task.author.lastname : 'N/A' }}
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge 
                                    {% if task.status == 'To Do' %}bg-secondary
                                    {% elseif task.status == 'In Progress' %}bg-primary
                                    {% elseif task.status == 'Done' %}bg-success
                                    {% endif %}">{{ task.status }}</span>
                                <small class="text-muted">{{ task.createdAt|date('d M Y') }}</small>
                            </div>
                            <hr>
                            <div class="text-end">
                                <a href="{{ path('task_show', {'id': task.id}) }}" class="btn btn-sm btn-info" title="View"><i class="fa-solid fa-eye"></i></a>
                                {% if app.user and app.user == task.author %}
                                    <a href="{{ path('task_edit', {'id': task.id}) }}" class="btn btn-sm btn-warning" title="Edit"><i class="fa-solid fa-pencil"></i></a>
                                    <form method="post" action="{{ path('task_delete', {'id': task.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                                        <button class="btn btn-sm btn-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card text-center">
                    <div class="card-body">
                        <p class="card-text">No tasks found. Be the first to create one!</p>
                        <a href="{{ path('task_new') }}" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Create a Task</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
