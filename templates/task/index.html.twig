{% extends 'base.html.twig' %}

{% block title %}Task List{% endblock %}

{% block body %}
    <h1>Task List</h1>

    <ul>
        {% for task in tasks %}
            <li>
                <a href="{{ path('task_show', {'id': task.id}) }}">{{ task.title }}</a>
            </li>
        {% else %}
            <li>No tasks found.</li>
        {% endfor %}
    </ul>
{% endblock %}
