{% extends 'base.html.twig' %}

{% block title %}Task Details: {{ task.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
{% endblock %}

{% block body %}
    {% for flash_message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ flash_message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="mb-0">{{ task.title }}</h1>
            <span class="badge 
                {% if task.status == 'To Do' %}bg-secondary
                {% elseif task.status == 'In Progress' %}bg-primary
                {% elseif task.status == 'Done' %}bg-success
                {% endif %}">{{ task.status }}</span>
        </div>
        <div class="card-body">
            <p class="card-text">{{ task.description|nl2br }}</p>
            <hr>
            <p class="card-text"><small class="text-muted">Created on {{ task.createdAt|date('F j, Y \a\t h:i A') }} by <strong>{{ task.author ? task.author.firstname ~ ' ' ~ task.author.lastname : 'N/A' }}</strong></small></p>
        </div>
        <div class="card-footer text-end">
            <a href="{{ path('task_list') }}" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Back to List</a>
            {% if app.user and app.user == task.author %}
                <a href="{{ path('task_edit', {'id': task.id}) }}" class="btn btn-warning me-1"><i class="fa-solid fa-pencil me-1"></i>Edit</a>
                <form method="post" action="{{ path('task_delete', {'id': task.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                    <button class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card mt-4 shadow-sm">
        <div class="card-header">
            <h2 class="mb-0"><i class="fa-solid fa-history me-2"></i>Task History</h2>
        </div>
        <div class="card-body">
            {% if history|length > 0 %}
                <ul class="list-group list-group-flush">
                    {% for entry in history %}
                        <li class="list-group-item"> 
                            <i class="fa-solid fa-clock me-2 text-muted"></i>{{ entry.changedAt|date('F j, Y, h:i A') }}: 
                            The task was <strong>{{ entry.action }}</strong> by {{ entry.user.firstname }} {{ entry.user.lastname }}.
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="mb-0">No history recorded for this task.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
