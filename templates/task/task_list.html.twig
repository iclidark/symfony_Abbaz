{% extends 'base.html.twig' %}

{% block title %}Task List{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Task List</h1>
        {# This route name needs to exist in your controller #}
        <a href="#" class="btn btn-success">New Task</a>
    </div>

    <div class="card">
        <div class="card-header">
            All Tasks
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>
                            <a href="{{ path('task_detail', {id: task.id}) }}">{{ task.title }}</a>
                        </td>
                        <td>{{ task.status }}</td>
                        <td>{{ task.createdAt|date('Y-m-d H:i') }}</td>
                        <td>
                            <div class="d-flex gap-2">
                                {# Add actions like edit or delete here #}
                                <a href="#" class="btn btn-warning btn-sm">Edit</a>
                                <a href="#" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">No tasks found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
