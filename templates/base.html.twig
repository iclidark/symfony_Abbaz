<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%22.9em%22 font-size=%2296%22>⚫️</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <style>
            body {
                display: flex;
                min-height: 100vh;
                margin: 0;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                background-color: #f4f6f9;
            }
            .sidebar {
                width: 240px;
                background-color: #2c3e50; /* Dark Slate Blue */
                color: #ecf0f1; /* Light text */
                padding: 20px;
            }
            .sidebar h3 {
                color: #fff;
                text-align: center;
                margin-bottom: 30px;
                font-size: 1.5em;
            }
            .sidebar nav {
                display: flex;
                flex-direction: column;
            }
            .sidebar a {
                padding: 12px 15px;
                text-decoration: none;
                color: #ecf0f1;
                border-radius: 5px;
                margin-bottom: 8px;
                transition: background-color 0.2s ease-in-out;
            }
            .sidebar a:hover {
                background-color: #34495e; /* Wet Asphalt */
            }
            .main-container {
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }
            header {
                padding: 20px 30px;
                background-color: #ffffff;
                border-bottom: 1px solid #dee2e6;
                box-shadow: 0 2px 4px rgba(0,0,0,.04);
                text-align: right;
            }
             header a {
                color: #3498db; /* Bright Blue */
                text-decoration: none;
                margin-left: 15px;
            }
            main {
                flex-grow: 1;
                padding: 30px;
            }
            main h1, main h2 {
                color: #2c3e50; /* Dark Slate Blue */
            }
            footer {
                padding: 20px;
                background-color: #ffffff;
                border-top: 1px solid #dee2e6;
                text-align: center;
                font-size: 0.9em;
                color: #6c757d;
            }

            /* Flash Messages Styles */
            .flash-success, .flash-error, .flash-info, .flash-warning {
                padding: 15px;
                margin-bottom: 20px;
                border-radius: 5px;
                color: #fff;
            }
            .flash-success {
                background-color: #2ecc71; /* Emerald Green */
            }
            .flash-error {
                background-color: #e74c3c; /* Alizarin Red */
            }
            .flash-info {
                background-color: #3498db; /* Peter River Blue */
            }
            .flash-warning {
                background-color: #f39c12; /* Sunflower Yellow */
                color: #111;
            }
        </style>
    </head>
    <body>
        <aside class="sidebar">
            <h3>My App</h3>
            <nav>
                <a href="{{ path('task_list') }}">Tasks</a>
                {# You can add other global navigation links here #}
            </nav>
        </aside>

        <div class="main-container">
            <header>
                {% if app.user %}
                    <span>Hello, {{ app.user.firstname }}!</span>
                    <a href="{{ path('app_logout') }}">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Login</a>
                    <a href="{{ path('app_register') }}">Register</a>
                {% endif %}
            </header>

            <main>
                {{ include('common/_flash_messages.html.twig') }}
                {% block body %}{% endblock %}
            </main>

            <footer>
                <p>&copy; {{ "now"|date("Y") }} - My Symfony App</p>
            </footer>
        </div>
    </body>
</html>
